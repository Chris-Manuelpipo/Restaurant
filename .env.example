# ═══════════════════════════════════════════════════════════════════════════
#  Evolyx Restaurant — variables d'environnement
#  Copier en `.env` à la racine : `cp .env.example .env`
# ═══════════════════════════════════════════════════════════════════════════

# ── Base de données ────────────────────────────────────────────────────────
# Avec docker compose, l'hôte est `postgres` ; en local, `localhost`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/evolyx_restaurant?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/evolyx_restaurant_test?schema=public"

# ── API ────────────────────────────────────────────────────────────────────
API_PORT=3010
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Secrets : à régénérer pour toute installation réelle (openssl rand -hex 48)
JWT_ACCESS_SECRET="dev-access-secret-a-remplacer-obligatoirement-en-production-0001"
JWT_REFRESH_SECRET="dev-refresh-secret-a-remplacer-obligatoirement-en-production-002"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7
# Domaine du cookie de rafraîchissement ; laisser vide en local.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ── URLs publiques ─────────────────────────────────────────────────────────
# Sert à composer les liens des QR codes et les redirections /public/q/:code
PUBLIC_MENU_URL="http://localhost:5181"
ADMIN_URL="http://localhost:5180"
API_PUBLIC_URL="http://localhost:3010"
# Les menus sont servis en chemin (/r/mon-resto) en local, en sous-domaine en production.
MENU_URL_MODE=path

# ── Stockage des images ────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH="./storage"
STORAGE_PUBLIC_PREFIX="/media"

# ── Fronts ─────────────────────────────────────────────────────────────────
VITE_API_URL="http://localhost:3010"

# ── Comptes de démonstration (créés par `pnpm seed`) ───────────────────────
# Plateforme     : platform@evolyx.cm        / MotDePasseDemo2026
# Le Braisé      : admin@lebraise.cm         / MotDePasseDemo2026
#                  gerant@lebraise.cm        / MotDePasseDemo2026   (MANAGER)
# Casa Lina      : admin@casalina.cm         / MotDePasseDemo2026
#                  gerant@casalina.cm        / MotDePasseDemo2026   (MANAGER)
SEED_PASSWORD="MotDePasseDemo2026"
