{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@evolyx/shared": ["../../packages/shared/src/index.ts"],
      "@evolyx/ui": ["../../packages/ui/src/index.tsx"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
