{
  "name": "evolyx-restaurant",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @evolyx/shared --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @evolyx/shared test && pnpm --filter @evolyx/api test:unit",
    "seed": "pnpm --filter @evolyx/api seed",
    "db:migrate": "pnpm --filter @evolyx/api db:migrate",
    "db:reset": "pnpm --filter @evolyx/api db:reset",
    "e2e": "pnpm --filter @evolyx/e2e test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "predev": "pnpm --filter @evolyx/shared build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0"
  }
}
